# Super Apps Backend Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ==================== SECURITY (REQUIRED) ====================

# JWT Secret Key - used to sign authentication tokens
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Or: openssl rand -base64 48
SECRET_KEY=

# Asset Encryption Key - encrypts sensitive asset data (passwords, credentials)
# NOT required in .env — auto-generated to backend/.superapps/encryption.key on first run
# WARNING: Do NOT change after creating assets - encrypted data becomes unrecoverable
# ASSET_ENCRYPTION_KEY=

# ==================== OPTIONAL ====================

# Admin password for sqlite-web (optional, defaults to random on startup)
ADMIN_PASS=

# CORS allowed origins (comma-separated, empty = allow all https:// origins)
CORS_ORIGINS=

# CORS subnet restriction (e.g., 192.168.60.0/24)
CORS_SUBNET=

# IP whitelist (comma-separated, empty = accept all)
ALLOWED_IPS=

# Application version (shown in /health endpoint)
APP_VERSION=1.0.0

# ==================== NOTES ====================
# - SECRET_KEY is auto-generated to backend/.superapps/secret.key on first run
# - ASSET_ENCRYPTION_KEY is auto-generated to backend/.superapps/encryption.key on first run
# - Both files have permission 0600 and survive git pull / deploy
# - Backup backend/.superapps/encryption.key securely - cannot be recovered if lost
# - .env in this directory is optional; secrets no longer need to be stored here
